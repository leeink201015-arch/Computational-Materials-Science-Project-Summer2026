&CONTROL
calculation = 'relax'
restart_mode = 'from_scratch'
prefix = 'fe_N2'
pseudo_dir = '/usr/share/espresso/pseudo/'
outdir = './tmp/'
/

&SYSTEM
ibrav = 0
nat = 10
ntyp = 2
nosym = .true.
ecutwfc = 45.0
ecutrho = 360.0
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
/

&ELECTRONS
conv_thr = 1.0d-8
mixing_beta = 0.7
/

&IONS
ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Fe   55.845  Fe.pbe-spn-rrkjus_psl.0.2.1.UPF
N    14.007  N.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
    2.870000     0.000000     0.000000
    0.000000     2.870000     0.000000
    0.000000     0.000000    22.960000

