&CONTROL
calculation = 'relax'
restart_mode = 'from_scratch'
prefix = 'fe_clean_fe_surface'
pseudo_dir = '/usr/share/espresso/pseudo/'
outdir = './tmp/'
/

&SYSTEM
ibrav = 0
nat = 8
ntyp = 1
nosym = .true.
ecutwfc = 45.0
ecutrho = 360.0
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
/

&ELECTRONS
conv_thr = 1.0d-8
mixing_beta = 0.7
/

&IONS
ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Fe   55.845  Fe.pbe-spn-rrkjus_psl.0.2.1.UPF

CELL_PARAMETERS angstrom
    2.870000     0.000000     0.000000
    0.000000     2.870000     0.000000
    0.000000     0.000000    22.960000

ATOMIC_POSITIONS angstrom
Fe      0.000000     0.000000     2.152500 0 0 0
Fe      1.435000     1.435000     0.717500 0 0 0
Fe      0.000000     0.000000     5.022500 0 0 0
Fe      1.435000     1.435000     3.587500 0 0 0
Fe      0.000000     0.000000     7.892500 0 0 0
Fe      1.435000     1.435000     6.457500 0 0 0
Fe      0.000000     0.000000    10.762500 1 1 1
Fe      1.435000     1.435000     9.327500 0 0 0

K_POINTS automatic
4 4 1 0 0 0
