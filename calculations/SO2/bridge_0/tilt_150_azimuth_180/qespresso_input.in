&CONTROL
calculation = 'relax'
restart_mode = 'from_scratch'
prefix = 'fe_SO2'
pseudo_dir = '/usr/share/espresso/pseudo/'
outdir = './tmp/'
/

&SYSTEM
ibrav = 0
nat = 11
ntyp = 3
nosym = .true.
ecutwfc = 45.0
ecutrho = 360.0
occupations = 'smearing'
smearing = 'mv'
degauss = 0.02
/

&ELECTRONS
conv_thr = 1.0d-8
mixing_beta = 0.7
/

&IONS
ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Fe   55.845  Fe.pbe-spn-rrkjus_psl.0.2.1.UPF
S    32.059  S.pbe-n-kjpaw_psl.1.0.0.UPF
O    15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF

